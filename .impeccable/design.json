      "css": ".ds-text-link{font-family:var(--font-body,Instrument,sans-serif);font-size:13px;color:var(--paper,#f5f0e6);display:inline-flex;align-items:center;gap:24px;min-height:44px;border-bottom:1px solid #777;text-decoration:none;transition:color .18s ease}.ds-text-link svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6}.ds-text-link:hover{color:var(--red,#ffac78)}.ds-text-link:focus-visible{outline:2px solid var(--red,#ffac78);outline-offset:6px;}",
