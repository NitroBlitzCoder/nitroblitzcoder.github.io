  "narrative": {
    "northStar": "Industrial Optical Monograph",
    "overview": "An industrial optical monograph in two materials: light-blue structure on warm cream by day, and CobaltSky navy with luminous blue by night. A small orange signal marks interaction. Wide typography, real software evidence, hairline divisions, and full-ratio photographs preserve the shared editorial identity across the portfolio and its separate archive.\n\nDepth belongs to procedural geometry, screenshots, and prints. The full-viewport hero introduces the experience with a blue particle ribbon; native-scroll project surfaces and the contextual lens carry it onward. Optional motion adds expression while static text, images, controls, and contact access remain available.",
    "keyCharacteristics": [
      "Wide display typography and restrained utility text.",
      "Flat editorial surfaces with real project screenshots.",
      "Persistent day/night materials shared with the photography archive.",
      "Split/blur live text and a direct, elastic image comparison.",
      "A compact optical study within personal context and an upward-angled circuit plane with faint technical vehicle drawings.",
      "Native scrolling, visible focus, and static graphics fallbacks."
    ],
    "rules": [
      {
        "name": "The Shared Materials Rule",
        "body": "Apply one selected theme across hero, project field, case studies, About, contact, dialogs and photography; use orange sparingly for action and feedback.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Anybody carries expressive headings; Instrument Sans carries reading and controls. Retained alternative font assets are inactive, not additional type roles.",
        "section": "typography"
      },
      {
        "name": "The Object Depth Rule",
        "body": "Keep editorial containers flat; reserve dimensional treatment for screenshot presentation, photographic prints and physical scene geometry.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve real screenshots and distinct editorial project compositions.",
      "Do keep orange focus outlines and controls with the existing interaction heights (44px generally, 36px in the narrowest header).",
      "Do provide the static lens state for reduced motion, effects off, and software rendering.",
      "Do use SVG paths for interface icons and keep circuit details faint and subordinate."
    ],
    "donts": [
      "Don't replace this system with generic card grids, decorative pills, or burgundy page backgrounds.",
      "Don't turn vehicles into click-operated exhibits or replace the homepage\u2019s contextual optical study with the photography archive; keep the archive on its own linked route.",
      "Don't require motion, hover, or graphics to reach factual content."
    ]
  }
}
