      "css": ".ds-theme-switch{position:relative;display:inline-flex;width:76px;height:44px;align-items:center;cursor:pointer}.ds-theme-switch input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;cursor:pointer;z-index:2}.ds-theme-track{position:relative;width:58px;height:34px;padding:0 9px;border-radius:20px;background:var(--raised,#102745);box-shadow:inset 0 0 0 1px var(--line,#304561);display:flex;align-items:center;justify-content:space-between;color:var(--muted,#afc2db)}.ds-theme-track:after{content:\"\";position:absolute;left:4px;top:4px;width:26px;height:26px;border-radius:50%;background:var(--red,#ffac78);transition:transform .5s cubic-bezier(.16,1,.3,1)}.ds-theme-switch input:checked+.ds-theme-track:after{transform:translateX(42px)}.ds-theme-track svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.5;z-index:1;transition:transform .5s}.ds-theme-switch:hover svg{transform:rotate(-12deg)}.ds-theme-switch input:focus-visible+.ds-theme-track{outline:2px solid var(--red,#ffac78);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-theme-track:after,.ds-theme-track svg{transition:none}}"
    }
