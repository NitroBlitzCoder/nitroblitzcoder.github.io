  "narrative": {
    "northStar": "Industrial Optical Monograph",
    "overview": "An industrial optical monograph: wide, compactly spaced typography, charcoal fields, warm paper, and a vivid red signal. Software evidence appears in generous editorial compositions, with hairline divisions rather than enclosing cards.\n\nDepth belongs to the objects and screenshots. A compact lens figure accompanies photography and modeling interests in About. Native scrolling reveals its construction; it remains optional, and the static experience retains readable project evidence and contact access.",
    "keyCharacteristics": [
      "Wide display typography and restrained utility text.",
      "Flat editorial surfaces with real project screenshots.",
      "A compact optical study within personal context and faint vehicle margin marks.",
      "Native scrolling, visible focus, and static graphics fallbacks."
    ],
    "rules": [
      {
        "name": "The Red Signal Rule",
        "body": "Use red for deliberate emphasis, interaction feedback, and the contact field; use the darker About red on warm paper.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Anybody carries expressive headings; Instrument Sans carries reading and controls. Retained alternative font assets are inactive, not additional type roles.",
        "section": "typography"
      },
      {
        "name": "The Object Depth Rule",
        "body": "Keep editorial containers flat; reserve dimensional treatment for screenshot presentation and physical scene geometry.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve real screenshots and distinct editorial project compositions.",
      "Do keep red focus outlines and controls with the existing interaction heights (44px generally, 36px in the narrowest header).",
      "Do provide the static lens state for reduced motion, effects off, and software rendering.",
      "Do use SVG paths for interface icons and keep vehicle silhouettes faint and subordinate."
    ],
    "donts": [
      "Don't replace this system with generic card grids, decorative pills, glowing gradients, or burgundy page backgrounds.",
      "Don't turn vehicles into click-operated exhibits or turn the camera theme into a photography gallery.",
      "Don't require motion, hover, or graphics to reach factual content."
    ]
  }
